#include <iostream>
using namespace std;
class Payment
{
public:
    virtual void pay()
    {
        cout << "General Payment Method" << endl;
    }
};
class CreditCard : public Payment
{
public:
    void pay() override
    {
        cout << "Payment made using Credit Card" << endl;
    }
};
class UPI : public Payment
{
public:
    void pay() override
    {
        cout << "Payment made using UPI" << endl;
    }
};
class NetBanking : public Payment
{
public:
    void pay() override
    {
        cout << "Payment made using Net Banking" << endl;
    }
};
int main()
{
    Payment *payment;
    int choice;
    cout << "------ E-COMMERCE PAYMENT SYSTEM ------" << endl;
    cout << "1. Credit Card" << endl;
    cout << "2. UPI" << endl;
    cout << "3. Net Banking" << endl;
    cout << "Enter your choice : ";
    cin >> choice;
    if (choice == 1)
    {
        payment = new CreditCard();
    }
    else if (choice == 2)
    {
        payment = new UPI();
    }
    else if (choice == 3)
    {
        payment = new NetBanking();
    }
    else
    {
        cout << "Invalid Choice" << endl;
        return 0;
    }
    payment->pay();
    delete payment;
    return 0;
}
